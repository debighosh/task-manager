# TaskFlow Spring Boot API origin. Vite inlines this at build time as
# import.meta.env.VITE_API_URL. Replace the host with the Railway URL.
# No path suffix. Changing it requires a new build (see docs/NETLIFY.md).
#
# Local `pnpm dev` calls http://localhost:8080 when this variable is unset,
# so you can skip copying this file. The API's default ALLOWED_ORIGINS
# already includes http://localhost:5173.
VITE_API_URL=https://your-api.up.railway.app
